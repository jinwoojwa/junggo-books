# 운영(VM)에서 쓰는 환경 변수 예시. 실제 값은 GitHub Secrets → 배포 시 VM의 .env로 생성한다.
# 이 파일을 복사해 .env로 쓰고, .env는 절대 커밋하지 않는다.

# DB
DB_HOST=db
DB_PORT=5432
DB_NAME=junggo_books
DB_USERNAME=junggo
DB_PASSWORD=

# 수집기
CRAWLER_USER_AGENT=junggo-books-crawler (contact: your-email@example.com)

# 알림 (디스코드 웹훅)
ALERT_WEBHOOK_URL=

# CORS
CORS_ALLOWED_ORIGINS=https://your-domain.com
