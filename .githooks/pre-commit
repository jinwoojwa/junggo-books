#!/usr/bin/env bash
# 커밋 전 빠른 검사: 스테이지된 Java 파일이 있으면 포맷(Spotless)만 확인한다.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if git diff --cached --name-only --diff-filter=ACMR | grep -q '\.java$'; then
  echo "pre-commit: spotlessCheck"
  if ! (cd backend && ./gradlew spotlessCheck -q); then
    echo "포맷 위반입니다. 'cd backend && ./gradlew spotlessApply' 후 다시 add 하세요." >&2
    exit 1
  fi
fi
